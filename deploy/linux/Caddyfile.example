karahanligida.com {
	encode zstd gzip

	@adminApi path /api/admin/*
	handle @adminApi {
		reverse_proxy 127.0.0.1:3100
	}

	handle_path /media/* {
		root * /srv/karahanli/data/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /data/products.json {
		rewrite * /products.json
		root * /srv/karahanli/data/catalog
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	handle_path /urunler/* {
		root * /srv/karahanli/data/generated/urunler
		header Cache-Control "public, max-age=300"
		file_server
	}

	handle {
		root * /srv/karahanli/app/current
		try_files {path} {path}/ /index.html
		file_server
	}
}
