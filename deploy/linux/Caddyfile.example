karahanligida.com {
	encode zstd gzip

	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@privateFiles path /.git /.git/* /.env /secrets/* /admin-api/* /firebase/* /deploy/* /tools/* /docs/* /.dockerignore /docker-compose.yml /firebase.json /README.md
	handle @privateFiles {
		respond 404
	}

	@adminApi path /api/admin/*
	handle @adminApi {
		reverse_proxy 127.0.0.1:3100
	}

	handle_path /media/* {
		root * /srv/karahanli/data/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle_path /assets/* {
		root * /srv/karahanli/app/current/assets
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /data/products.json {
		rewrite * /products.json
		root * /srv/karahanli/data/catalog
		header Cache-Control "public, max-age=60, must-revalidate"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
