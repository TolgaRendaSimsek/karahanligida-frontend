rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Ziyaretçiler Linux üzerinde üretilen statik products.json dosyasını
    // okur. Admin işlemleri kimlik doğrulayan Linux API ve Admin SDK üzerinden
    // yapılır; Admin SDK bu istemci kurallarını kullanmaz.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
